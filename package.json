{
  "name": "artificialbluff",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "demo": "tsx packages/core/scripts/demo.ts",
    "smoke": "tsx --env-file=.env packages/core/scripts/smoke.ts",
    "study": "tsx apps/study/src/cli.ts",
    "live": "tsx apps/server/src/main.ts",
    "web": "pnpm --filter @ab/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
